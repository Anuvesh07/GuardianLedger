rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidUsername(username) {
      return username is string && 
             username.size() >= 3 && 
             username.size() <= 30 &&
             username.matches('^[a-z0-9_]+$');
    }
    
    // Users collection
    match /users/{userId} {
      // Anyone authenticated can read user profiles (for social features)
      allow read: if isAuthenticated();
      
      // Only the user can create their own profile
      allow create: if isOwner(userId) && 
                      request.resource.data.keys().hasAll(['email', 'username', 'displayName', 'createdAt']) &&
                      isValidUsername(request.resource.data.username) &&
                      request.resource.data.email is string &&
                      request.resource.data.displayName is string &&
                      request.resource.data.displayName.size() >= 1 &&
                      request.resource.data.displayName.size() <= 100;
      
      // Only the user can update their own profile
      allow update: if isOwner(userId) &&
                      request.resource.data.userId == userId;
      
      // Users cannot delete their profile
      allow delete: if false;
    }
    
    // Expenses collection
    match /expenses/{expenseId} {
      // Anyone authenticated can read any expense (for social feature)
      allow read: if isAuthenticated();
      
      // Users can only create expenses for themselves
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.keys().hasAll(['userId', 'title', 'amount', 'category', 'date', 'createdAt']) &&
                      request.resource.data.title is string &&
                      request.resource.data.title.size() >= 1 &&
                      request.resource.data.title.size() <= 200 &&
                      request.resource.data.amount is number &&
                      request.resource.data.amount > 0 &&
                      request.resource.data.amount <= 1000000 &&
                      request.resource.data.category is string &&
                      request.resource.data.category.size() >= 1 &&
                      request.resource.data.date is timestamp &&
                      request.resource.data.createdAt is timestamp;
      
      // Users can only update their own expenses
      allow update: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid &&
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.amount > 0 &&
                      request.resource.data.amount <= 1000000;
      
      // Users can only delete their own expenses
      allow delete: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
    }
  }
}
